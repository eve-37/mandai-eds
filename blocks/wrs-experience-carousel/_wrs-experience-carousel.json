        {
          "component": "select",
          "name": "layout_padding",
          "label": "Section Padding",
          "description": "Combines the source's noTopPadding/noBottomPadding checkboxes into one field, the same technique wrs-four-column-listing uses (see docs/wrs-migration-notes.md), so the two booleans never land in the same grouped cell with no way to tell which is which.",
          "valueType": "string",
          "value": "none",
          "options": [
            { "name": "Normal padding", "value": "none" },
            { "name": "No top padding", "value": "no-top" },
            { "name": "No bottom padding", "value": "no-bottom" },
            { "name": "No top or bottom padding", "value": "no-top-bottom" }
          ]
        },
        {
          "component": "text",
          "name": "color_body",
          "label": "Content Body Default Color",
          "description": "Hex or CSS colour value. This field, and the seven below, are all freeform colour text - there is no colorfield component in this project's Universal Editor field set, matching the same 'text' idiom used everywhere else in this repo for a free colour value (see docs/wrs-migration-notes.md ## backgroundsection). All eight are explicitly prefixed color_ so none of them accidentally collapse into a sibling via the model-build suffix rule - contentBody + Title/Text are exactly the Title/Text suffixes the xwalk max-cells linter collapses onto a base field named contentBody, which would silently have merged three distinct colours into one had the original field names been kept as-is.",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "color_bodyHover",
          "label": "Content Body Hover Effect Color",
          "valueType": "string"
        },
